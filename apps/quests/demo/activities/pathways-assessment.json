              },
              {
                "label": "Personal growth and learning",
                "value": "growth"
              },
              {
                "label": "Connection and relationships",
                "value": "connection"
              },
              {
                "label": "Inner peace and calm",
                "value": "peace"
              },
              {
                "label": "Sense of purpose and meaning",
                "value": "purpose"
              },
              {
                "label": "Work-life balance",
                "value": "balance"
              },
              {
                "label": "Creativity and expression",
                "value": "creativity"
