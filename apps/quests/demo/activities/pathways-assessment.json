            "question_id": "mindfulness_intention",
            "question_type": "text_input"
          }
        },
        {
          "index": 4,
          "block_type": "multiple_choice",
          "config": {
            "title": "How do you prefer to stay accountable to your mindfulness goals?",
            "options": [
              {
                "label": "Regular self-reflection and journaling",
                "value": "self_reflection"
              },
              {
                "label": "An accountability partner or friend",
                "value": "accountability_partner"
              },
              {
                "label": "A structured program or course",
                "value": "structured_program"
              },
              {
                "label": "A mindfulness community or group",
                "value": "community_group"
              },
              {
                "label": "Apps, reminders, or digital tools",
                "value": "apps_reminders"
              },
              {
                "label": "I prefer a flexible, intuitive approach",
                "value": "flexible_approach"
              }
            ],
            "required": true,
            "question_id": "support_preference",
            "question_type": "single_choice"
          }
        },
        {
          "index": 5,
          "block_type": "text_input",
          "config": {
