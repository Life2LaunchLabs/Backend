    {
      "index": 2,
      "title": "Mindful Decision Making",
      "meta": {
        "page_type": "assessment"
      },
      "blocks": [
        {
          "index": 0,
          "block_type": "text",
          "config": {
            "style": "h2",
            "content": "Mindful Decision Making"
          }
        },
        {
          "index": 1,
          "block_type": "media",
          "config": {
            "size": "medium",
            "caption": "Every choice is an opportunity for growth and discovery.",
            "media_filename": "b450c2ae-0ad0-4dd2-862a-1881191f2314.png"
          }
        },
        {
          "index": 2,
          "block_type": "text",
          "config": {
            "style": "body",
            "content": "Consider the following scenarios and reflect on how mindfulness might guide your choices."
          }
        },
        {
          "index": 3,
          "block_type": "multiple_choice",
          "config": {
            "title": "You're facing a stressful deadline at work. Which approach feels most aligned with mindful living?",
            "options": [
              {
                "label": "Rush through tasks, accepting stress as inevitable",
                "value": "rush_panic"
              },
              {
                "label": "Pause, take three deep breaths, then prioritize mindfully",
                "value": "pause_breathe"
              },
              {
                "label": "Avoid the stress by procrastinating or distraction",
                "value": "avoid_procrastinate"
              },
              {
                "label": "Push through with determination, ignoring physical/emotional signals",
                "value": "push_through"
              }
            ],
            "required": true,
            "question_id": "stress_response",
            "question_type": "single_choice"
          }
        },
        {
          "index": 4,
          "block_type": "media",
          "config": {
            "size": "small",
            "caption": "Mindful choices create ripple effects in our lives.",
            "media_filename": "603e89fc-2c53-4d2a-9b2f-17ad3a6b9099.png"
          }
        },
        {
          "index": 5,
          "block_type": "multiple_choice",
          "config": {
            "title": "Which values are most important to you in daily life? (Select all that apply)",
            "options": [
              {
                "label": "Compassion and kindness",
                "value": "compassion"
              },
              {
                "label": "Authenticity and honesty",
                "value": "authenticity"
              },
              {
                "label": "Personal growth and learning",
                "value": "growth"
              },
              {
                "label": "Connection and relationships",
                "value": "connection"
              },
              {
                "label": "Inner peace and calm",
                "value": "peace"
              },
              {
                "label": "Sense of purpose and meaning",
                "value": "purpose"
              },
              {
                "label": "Work-life balance",
                "value": "balance"
              },
              {
                "label": "Creativity and expression",
                "value": "creativity"
              }
            ],
            "required": false,
            "question_id": "core_values",
            "question_type": "multiple_choice",
            "multiple_selection": true
          }
        }
      ]
    },
