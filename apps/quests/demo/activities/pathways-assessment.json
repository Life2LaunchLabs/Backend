          "index": 1,
          "block_type": "media",
          "config": {
            "size": "medium",
            "caption": "Every choice is an opportunity for growth and discovery.",
            "media_filename": "07bca47e-76b1-4079-b04a-bd3996ba46e6.png"
          }
        },
        {
          "index": 2,
          "block_type": "text",
          "config": {
            "style": "body",
            "content": "Consider the following scenarios and reflect on how mindfulness might guide your choices."
          }
        },
        {
          "index": 3,
          "block_type": "question",
          "config": {
            "options": [
              {
                "label": "Rush through tasks, accepting stress as inevitable",
                "value": "rush_panic"
              },
              {
                "label": "Pause, take three deep breaths, then prioritize mindfully",
                "value": "pause_breathe"
              },
              {
                "label": "Avoid the stress by procrastinating or distraction",
                "value": "avoid_procrastinate"
              },
              {
                "label": "Push through with determination, ignoring physical/emotional signals",
                "value": "push_through"
              }
